# Declarative IPv4 policy. Docker and Tailscale chains are dynamic; the
# apply script preserves them and inserts only host policy.
*filter
:INPUT DROP [0:0]
:FORWARD DROP [0:0]
:OUTPUT ACCEPT [0:0]
:DOCKER-USER - [0:0]
-A INPUT -i lo -j ACCEPT
-A INPUT -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
-A INPUT -p tcp -s 192.168.0.0/24 --dport 22 -j ACCEPT
-A INPUT -p tcp -s 192.168.0.0/24 --dport 9090 -j ACCEPT
-A DOCKER-USER -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
-A DOCKER-USER -p tcp -s 192.168.0.23/32 --dport 9001 -j ACCEPT
-A DOCKER-USER -j RETURN
COMMIT
